# Backend API URL for Rally
# For local development with phone on same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://YOUR_MAC_LOCAL_IP:5001/api

# For tunneled URL (ngrok / Cloudflare tunnel / localtunnel):
# EXPO_PUBLIC_API_URL=https://your-tunnel-subdomain.ngrok-free.app/api

# For deployed production backend (e.g. Render, Railway):
# EXPO_PUBLIC_API_URL=https://rally-api.onrender.com/api
